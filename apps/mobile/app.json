{
  "expo": {
    "name": "Axon",
    "slug": "Axon",
    "scheme": "axon.thecommit.company",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "W6346TTZQX",
      "bundleIdentifier": "axon.thecommit.company",
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch",
          "voip"
        ],
        "NSCameraUsageDescription": "Axon uses your camera for video calls.",
        "NSMicrophoneUsageDescription": "Axon uses your microphone for voice and video calls."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "axon.thecommit.company",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/splash.png"
          }
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CalSans-SemiBold.otf"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "compileSdkVersion": 34
          }
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3a173ddd-f22a-4f81-8279-40dcee6c29d5"
      }
    },
    "owner": "your-org"
  }
}
