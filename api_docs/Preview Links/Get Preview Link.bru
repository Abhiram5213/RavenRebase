meta {
  name: Get Preview Link
  type: http
  seq: 1
}

get {
  url: {{url}}:{{port}}/api/method/axon.api.preview_links.get_preview_link?urls=["https://axonapp.info"]
  body: none
  auth: none
}

query {
  urls: ["https://axonapp.info"]
  ~urls: ["http://192.168.0.0"]
}

headers {
  Authorization: token {{api_key}}:{{api_secret}}
}
